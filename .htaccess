RewriteEngine On

# Backstop: never serve markdown or Claude files, even if one is uploaded by mistake.
RewriteRule ^(.*/)?(\.claude(/.*)?|[^/]*\.md)$ - [NC,F,L]

# social-studio/ is a separate Node.js app served on its own subdomain
# (social.seacoastdj.com), not by this static vhost. Block it here too in
# case its source ever syncs into this document root via git auto-deploy.
RewriteRule ^social-studio(/.*)?$ - [NC,F,L]

# Rule order matters, and everything redirecting lives in mod_rewrite (not
# mod_alias Redirect) on purpose: Apache and LiteSpeed order those two
# mechanisms differently, which left www legacy URLs bouncing twice. Every
# redirect below goes to the final canonical address (https://seacoastdj.com/...)
# in ONE hop and sits above the www rule, so www and non-www both get one hop.

# Retired for good, answered with 410 Gone (not a bare 404) so Google drops
# them faster, on any host:
#  - /rentals/*: equipment is bundled into GigBuilder packages now.
#  - /website-intelligence/: a separate business, removed from this site.
RewriteRule ^(rentals|website-intelligence)(/.*)?$ - [NC,G,L]

# Every /index.html was also directly reachable alongside its clean
# directory URL (e.g. /weddings/index.html and /weddings/ both served 200).
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://seacoastdj.com/$1 [L,R=301]

# Section URLs without the trailing slash: add it and fix the host together.
RewriteRule ^(weddings|corporate|private|services)$ https://seacoastdj.com/$1/ [L,R=301]

# Equipment rentals page merged into /gear.html (equipment now ships inside every package, so there is no standalone rentals page); legacy wedding packages page merged into /weddings/.
RewriteRule ^services/rentals\.html$ https://seacoastdj.com/gear.html [R=301,L]
RewriteRule ^weddings/wedding-packages\.html$ https://seacoastdj.com/weddings/ [R=301,L]

# Old index.php files that used to shadow the current pages.
RewriteRule ^weddings/index\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^services/index\.php$ https://seacoastdj.com/services/ [R=301,L]

# Legacy pages from the pre-redesign site, redirected to their closest current equivalent so old backlinks/bookmarks/search results don't 404.
RewriteRule ^about\.html$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^homepage\.html$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^promo-site\.html$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^default\.php$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^sandbox2020\.html$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^reviews\.php$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^section-reviews\.html$ https://seacoastdj.com/ [R=301,L]
RewriteRule ^wedding-packages\.html$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings\.html$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^partners-venues\.html$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^event-services\.html$ https://seacoastdj.com/services/ [R=301,L]
RewriteRule ^gallery\.html$ https://seacoastdj.com/media.html [R=301,L]
RewriteRule ^photography\.html$ https://seacoastdj.com/media.html [R=301,L]
RewriteRule ^contact-us\.html$ https://seacoastdj.com/contact.html [R=301,L]
RewriteRule ^check-availability\.html$ https://seacoastdj.com/contact.html [R=301,L]
RewriteRule ^date-available\.html$ https://seacoastdj.com/contact.html [R=301,L]
RewriteRule ^reserve-soon\.html$ https://seacoastdj.com/contact.html [R=301,L]
RewriteRule ^thanks\.html$ https://seacoastdj.com/thank-you.html [R=301,L]
RewriteRule ^weddings/faqs\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/wedding-packages\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/wedding-pricing\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/wedding-pricing\ -\ Copy\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/wedding-pricing-comparison\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/recommended-venues\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/friends-affiliates\.php$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/gigbuilder-wedding-outline\.html$ https://seacoastdj.com/weddings/ [R=301,L]
RewriteRule ^weddings/equipment\.php$ https://seacoastdj.com/gear.html [R=301,L]
RewriteRule ^weddings/email-anniversary\.html$ https://seacoastdj.com/private/ [R=301,L]

# Canonicalize host: www.seacoastdj.com served the full site with no redirect
# to seacoastdj.com, so Google crawled and indexed both as duplicates. Must
# stay BELOW the redirects above so they take precedence.
RewriteCond %{HTTP_HOST} ^www\.seacoastdj\.com$ [NC]
RewriteRule ^(.*)$ https://seacoastdj.com/$1 [L,R=301]

# Serve the rebuilt index.html over any legacy index.php sitting in the
# same directory (e.g. weddings/, services/) so old, unrelated PHP files
# left on the server can't silently shadow the current site.
DirectoryIndex index.html index.php
