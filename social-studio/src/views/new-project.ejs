<%- include('partials/head') %><%- include('partials/nav') %><main class="container narrow"><a href="/" class="back">← Dashboard</a><p class="eyebrow">NEW CONTENT PROJECT</p><h1>Tell the story behind the event.</h1><p class="muted">A few useful details produce stronger, more authentic drafts. Exact venue addresses or client names are not needed.</p><form class="panel stack" method="post" action="/projects" enctype="multipart/form-data"><div class="two-col"><label>Project name<input name="title" required placeholder="Hampton Beach reception"></label><label>Town or service area<input name="town" placeholder="Hampton, NH"></label></div><div class="two-col"><label>Vertical<select name="vertical" required><option value="">Select one…</option><option value="wedding">Wedding</option><option value="corporate">Corporate</option><option value="private">Private</option><option value="rental">Rental</option></select></label><label>Project stage<select name="stage"><option value="finished">Finished</option><option value="progress">In progress</option><option value="before-after">Before and after</option></select></label></div><label>Equipment or setup notes<input name="materials" placeholder="Rane gear, dance floor lighting, wireless mics"></label><label>Features<textarea name="features" placeholder="Uplighting, photo booth, live mixing"></textarea></label><label class="dropzone">Photos and short videos<input type="file" name="media" multiple accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime"><span>Select up to 12 JPG, PNG, WebP, MP4, or MOV files</span></label><fieldset><legend>Privacy review</legend><label class="check"><input type="checkbox" name="privacyApproved" value="yes" required> I am authorized to use this media for business marketing.</label><label class="check"><input type="checkbox" name="hideIdentity" value="yes" checked> Do not mention names or identifying details.</label><label class="check"><input type="checkbox" name="exactLocationAllowed" value="yes"> The client approved mentioning an exact venue.</label></fieldset><button class="primary">Create project</button></form></main><%- include('partials/foot') %>
