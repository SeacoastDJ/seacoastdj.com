<%- include('partials/head') %><%- include('partials/nav') %><main class="container"><section class="hero"><div><p class="eyebrow">CONTENT WORKSPACE</p><h1>Turn event photos into content that books the next date.</h1><p>Upload event photos, generate drafts, and approve what represents Seacoast DJ.</p></div><a class="primary button" href="/projects/new">+ New project</a></section><section class="connection-strip <%= metaConnection ? 'connected' : '' %>"><div><b><%= metaConnection ? 'Meta accounts connected' : 'Meta publishing is not connected' %></b><p><%= metaConnection ? `${metaConnection.pageName}${metaConnection.instagramUsername ? ` · @${metaConnection.instagramUsername}` : ''}` : (metaConfigured ? 'Authorize the Seacoast DJ Page and Instagram account.' : 'Complete the environment settings first.') %></p></div><a class="button secondary" href="/settings/meta"><%= metaConnection ? 'Manage connection' : 'Set up Meta' %></a></section><section class="stats"><article><strong><%= projects.length %></strong><span>Total projects</span></article><article><strong><%= counts.draft || 0 %></strong><span>Drafts ready</span></article><article><strong><%= (counts.approved || 0) + (counts.published || 0) %></strong><span>Approved</span></article></section><section class="section-head"><div><p class="eyebrow">CONTENT PIPELINE</p><h2>Recent projects</h2></div></section><div class="project-grid"><% if (!projects.length) { %><div class="empty"><h3>Your media inbox is ready.</h3><p>Create the first project using photos from a completed or upcoming event.</p><a class="button secondary" href="/projects/new">Create first project</a></div><% } %><% projects.forEach(project => { %><a class="project-card" href="/projects/<%= project.id %>"><div class="project-thumb"><% if (project.files[0] && project.files[0].mimeType.startsWith('image/')) { %><img src="/media/<%= project.id %>/<%= project.files[0].id %>" alt=""><% } else { %><span><%= project.files.length %> media</span><% } %></div><div><span class="status <%= project.status %>"><%= project.status %></span><h3><%= project.title %></h3><p><%= [project.town, project.vertical].filter(Boolean).join(' · ') || 'Project details pending' %></p></div></a><% }) %></div></main><%- include('partials/foot') %>
