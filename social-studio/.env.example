NODE_ENV=development

APP_NAME=Seacoast DJ Social Studio
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@seacoastdj.com
ADMIN_PASSWORD=change-me-before-running
MAX_UPLOAD_MB=50

# Optional. The app works fully without either of these (free template
# captions), and each provider's UI only appears once its key is set.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_DETAIL=high
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Meta (Facebook Page + Instagram) publishing. Already-known values for the
# SeacoastDJ Social Studio Meta app are in INSTALL-META.md.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_REDIRECT_URI=
META_GRAPH_VERSION=v24.0
META_TOKEN_ENCRYPTION_KEY=
META_MEDIA_SIGNING_SECRET=
PUBLIC_BASE_URL=
